<?xml version="1.0" encoding="UTF-8"?>
<!-- Nagorik Seba logging (Phase 6, §10): single-line console records carrying
     the MDC correlation fields (traceId, municipalityId, complaintId).
     A logstash JSON encoder is the documented upgrade once a JSON sink exists;
     until then this pattern keeps every field greppable without new deps. -->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level traceId=%X{traceId:-none} municipalityId=%X{municipalityId:-none} complaintId=%X{complaintId:-none} [%thread] %logger{36} - %msg%n"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
